# Copiar a /srv/fase0/.env en el VPS y completar ALLÍ (nano). Permisos: chmod 600 .env
# Nunca commitear .env ni pegar estos valores en un chat.

# Dominio de la prueba (registro A apuntando a la IP del VPS). Lo usa Caddy para el certificado.
FASE0_DOMAIN=fase0.ejemplo.org

# Gemini (Google AI Studio, proyecto con facturación)
GEMINI_API_KEY=

# LiveKit Cloud (proyecto del plan Build)
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Contraseña de la cabina (20+ caracteres)
BROADCAST_PASSWORD=
