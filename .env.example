# Copiar a .env y completar. El banco lee este archivo automáticamente.

# OpenAI: gpt-realtime-translate, whisper-1 (transcripción de referencia) y juez automático
OPENAI_API_KEY=

# Google AI Studio: gemini-3.5-live-translate-preview
GEMINI_API_KEY=

# Modelo usado por el comando `judge` (calificación automática). Opcional.
JUDGE_MODEL=gpt-5

# Hibiki-Zero (motor local, ver docs/hibiki-zero.md). Opcionales; estos son los valores por defecto.
# HIBIKI_BRIDGE_URL=ws://127.0.0.1:8999
# HIBIKI_URL=ws://127.0.0.1:8998/api/chat
# HIBIKI_AUTOSTART=0
# HIBIKI_PYTHON=python
